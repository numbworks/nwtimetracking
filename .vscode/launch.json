{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Debug: nwtimetrackingcli",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/nwtimetrackingcli.py",
            "console": "integratedTerminal",
            "args": [
